{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "prompt_coding.schema.json",
    "title": "Prompt para proyectos de coding con tutor IA",
    "description": "Esquema de un prompt reutilizable: datos del proyecto + rol del LLM como tutor de programación.",
    "type": "object",
    "required": [
        "proyecto",
        "rol_LLM"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "proyecto": {
            "type": "object",
            "description": "Configuración general y contexto del proyecto.",
            "required": [
                "nombre",
                "fecha_de_entrega",
                "nivel_actual",
                "contexto"
            ],
            "additionalProperties": false,
            "properties": {
                "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Ej. Chat con personaje de IA"
                },
                "modulo_curso": {
                    "type": "string",
                    "description": "Ej. SoyHenry - Módulo 3"
                },
                "fecha_de_entrega": {
                    "type": "string",
                    "format": "date",
                    "description": "Formato YYYY-MM-DD"
                },
                "nivel_actual": {
                    "type": "string",
                    "enum": [
                        "principiante total",
                        "intermedio",
                        "avanzado"
                    ]
                },
                "tecnologias_sugeridas": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                },
                "principal_freno": {
                    "type": "string",
                    "description": "Ej. Me cuesta la asincronía / No sé por dónde empezar"
                },
                "contexto": {
                    "type": "string",
                    "minLength": 1,
                    "description": "De qué va el proyecto (3 o 4 líneas)."
                },
                "funcionalidades_minimas": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Lo mínimo que debe tener el proyecto para aprobar."
                }
            }
        },
        "rol_LLM": {
            "type": "object",
            "description": "Cómo debe comportarse el LLM.",
            "required": [
                "rol",
                "prioridad",
                "principios",
                "restricciones_flexibles",
                "evidencia",
                "protocolo_emergencia",
                "modo_rapido"
            ],
            "additionalProperties": false,
            "properties": {
                "rol": {
                    "type": "string",
                    "description": "Ej. tutor de programación"
                },
                "prioridad": {
                    "type": "string",
                    "description": "Qué importa más que dar código hecho."
                },
                "principios": {
                    "type": "object",
                    "required": [
                        "explicacion_linea_por_linea",
                        "ensenanza_conceptual_antes_que_sintactica",
                        "construccion_guiada",
                        "preguntas_para_autonomia",
                        "control_en_emergencias"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "explicacion_linea_por_linea": {
                            "type": "string"
                        },
                        "ensenanza_conceptual_antes_que_sintactica": {
                            "type": "string"
                        },
                        "construccion_guiada": {
                            "type": "object",
                            "required": [
                                "descripcion",
                                "entregables"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "descripcion": {
                                    "type": "string"
                                },
                                "entregables": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "preguntas_para_autonomia": {
                            "type": "object",
                            "required": [
                                "descripcion",
                                "ejemplos",
                                "si_me_equivoco"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "descripcion": {
                                    "type": "string"
                                },
                                "ejemplos": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "si_me_equivoco": {
                                    "type": "string"
                                }
                            }
                        },
                        "control_en_emergencias": {
                            "type": "string"
                        }
                    }
                },
                "restricciones_flexibles": {
                    "type": "object",
                    "required": [
                        "entendimiento_vs_pragmatismo",
                        "tamano_del_codigo",
                        "romper_la_consigna",
                        "informacion_actualizada",
                        "repeticion_espaciada"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "entendimiento_vs_pragmatismo": {
                            "type": "string"
                        },
                        "tamano_del_codigo": {
                            "type": "string"
                        },
                        "romper_la_consigna": {
                            "type": "string"
                        },
                        "informacion_actualizada": {
                            "type": "string"
                        },
                        "repeticion_espaciada": {
                            "type": "string"
                        }
                    }
                },
                "evidencia": {
                    "type": "object",
                    "required": [
                        "como_la_subo",
                        "nota_sobre_mi_codigo"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "como_la_subo": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nota_sobre_mi_codigo": {
                            "type": "string"
                        }
                    }
                },
                "protocolo_emergencia": {
                    "type": "object",
                    "required": [
                        "nombre_modo",
                        "disparadores",
                        "pasos",
                        "cierre"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "nombre_modo": {
                            "type": "string"
                        },
                        "disparadores": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "pasos": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "cierre": {
                            "type": "string"
                        }
                    }
                },
                "modo_rapido": {
                    "type": "object",
                    "required": [
                        "frase_activadora",
                        "descripcion",
                        "por_defecto"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "frase_activadora": {
                            "type": "string"
                        },
                        "descripcion": {
                            "type": "string"
                        },
                        "por_defecto": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
